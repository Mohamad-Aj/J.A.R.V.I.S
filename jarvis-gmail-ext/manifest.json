{
    "manifest_version": 3,
    "name": "JARVIS Email Assistant",
    "version": "1.2",
    "description": "Let JARVIS help write your Gmail emails.",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://mail.google.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "inject.js"
            ]
        }
    ]
}